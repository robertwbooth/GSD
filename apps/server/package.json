{
  "name": "@gsd/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "GSD_DATA_DIR=../../data GSD_PASSWORD=${GSD_PASSWORD:-dev} tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:@fastify/static --external:better-sqlite3 --outfile=dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@gsd/core": "*",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
