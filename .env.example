# Password you sign in with on every device.
GSD_PASSWORD=change-me

# Optional: file in-app feedback as GitHub issues.
# Create a fine-grained token with "Issues: read and write" on this repo only.
GSD_GITHUB_TOKEN=
GSD_GITHUB_REPO=robertwbooth/gsd

# Optional: live sync with TickTick while you move over.
# Register an app at https://developer.ticktick.com/manage with the redirect URL
# <GSD_PUBLIC_URL>/api/ticktick/callback, then paste its Client ID and Secret here.
GSD_PUBLIC_URL=
GSD_TICKTICK_CLIENT_ID=
GSD_TICKTICK_CLIENT_SECRET=
